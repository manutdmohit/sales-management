# Copy to .env.local for local development:
#   cp .env.example .env.local
#
# Variables marked (required) must be set before production deploy.

# --- Database (required) ---
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=inventory_platform

# --- Auth (required in production) ---
# Generate: openssl rand -base64 32
AUTH_SECRET=

# --- Seed users (optional — used by npm run seed:admin) ---
ADMIN_EMAIL=admin@inventory.local
ADMIN_PASSWORD=admin123
ADMIN_NAME=Admin
STAFF_EMAIL=staff@inventory.local
STAFF_PASSWORD=staff123
STAFF_NAME=Staff

# --- App URL (optional — links in emails and notifications) ---
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Scheduled jobs (optional locally; set on Vercel for cron) ---
# Protects GET/POST /api/cron/reminders (credit reminders + batch expiry alerts)
CRON_SECRET=
REMINDER_TIMEZONE=Asia/Kathmandu

# --- Email via Resend (optional) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=Inventory Platform <onboarding@resend.dev>
NOTIFICATION_EMAIL=admin@inventory.local
TEST_EMAIL_TO=

# --- Receipt uploads via Cloudinary (optional) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=inventory-platform
